#!/bin/sh
# Sécurité du système : pare-feu et mises à jour de Brume lui-même (les correctifs de Debian sont réglés dans
# /etc/apt/apt.conf.d/20auto-upgrades). Le chiffrement du disque est proposé par l'installateur (Calamares, voir
# etc/calamares/modules/partition.conf).
set -u

# Active un service (comme « systemctl enable », qui peut échouer dans l'image en construction)
activer() {
  systemctl enable "$1" 2>/dev/null && return 0
  for d in /etc/systemd/system /lib/systemd/system /usr/lib/systemd/system; do
    if [ -f "$d/$1" ]; then
      mkdir -p "/etc/systemd/system/$2.wants"
      ln -sf "$d/$1" "/etc/systemd/system/$2.wants/$1"
      return 0
    fi
  done
  echo "Avertissement : $1 introuvable" >&2
}

# Pare-feu : tout ce qui arrive d'un autre appareil est refusé, sauf le partage à proximité et la découverte des
# imprimantes (voir /usr/share/brume/pare-feu.nft). Actif aussi sur la clé USB.
if [ -f /usr/share/brume/pare-feu.nft ]; then
  install -m 0755 /usr/share/brume/pare-feu.nft /etc/nftables.conf
  activer nftables.service sysinit.target
fi

# Disque chiffré : au démarrage, le mot de passe se tape avec la disposition du clavier choisie (AZERTY…), pas en
# QWERTY. La disposition est mise dans l'initramfs (paquet console-setup).
if [ -f /etc/initramfs-tools/initramfs.conf ]; then
  if grep -q '^KEYMAP=' /etc/initramfs-tools/initramfs.conf; then
    sed -i 's/^KEYMAP=.*/KEYMAP=y/' /etc/initramfs-tools/initramfs.conf
  else
    echo 'KEYMAP=y' >> /etc/initramfs-tools/initramfs.conf
  fi
fi

# Mises à jour de Brume lui-même (moteur web compris), sur un ordinateur où Brume est installé
chmod 755 /usr/local/sbin/brume-maj
activer brume-maj.timer timers.target

exit 0
