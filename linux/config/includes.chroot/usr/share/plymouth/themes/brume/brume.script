# Brume OS : écran de démarrage du système (Plymouth, module « script »).
# Mêmes couleurs, mêmes tailles et mêmes places que l'écran de démarrage de Brume (#boot dans index.html) :
# logo de 112 px dont le centre est 28 px au-dessus du milieu de l'écran, barre de 176 x 4 px 60 px sous le milieu.
# La barre avance jusqu'à 60 % pendant le démarrage du système, puis Brume la reprend là où elle en est.
# À l'extinction et au redémarrage : « Arrêt en cours » ou « Redémarrage en cours » à la place du logo, comme l'écran
# d'arrêt de Brume (même police, même place), dans la langue de Brume (arret.png et redemarrage.png, copiées au début
# de l'extinction par /usr/local/sbin/brume-arret), et la barre, qui repart de 40 %, là où Brume l'a laissée.
# Disque chiffré : un champ pour le mot de passe.

Window.SetBackgroundTopColor(0.067, 0.082, 0.106);       # #11151b
Window.SetBackgroundBottomColor(0.067, 0.082, 0.106);

cx = Window.GetX() + Math.Int(Window.GetWidth() / 2);
cy = Window.GetY() + Math.Int(Window.GetHeight() / 2);
mode = Plymouth.GetMode();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - 56, cy - 84, 10);

track.image = Image("bar-track.png");
track.sprite = Sprite(track.image);
track.sprite.SetPosition(cx - 88, cy + 60, 10);

fill.image = Image("bar-fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(cx - 88, cy + 60, 11);
fill.width = 0;

# Extinction ou redémarrage : le texte à la place du logo (boîte de 72 px dont le haut est 64 px au-dessus du milieu)
halt = 0;
if (mode == "shutdown" || mode == "reboot")
  halt = 1;
if (halt)
  {
    if (mode == "reboot")
      title.image = Image("redemarrage.png");
    else
      title.image = Image("arret.png");
    title.sprite = Sprite(title.image);
    title.sprite.SetPosition(cx - Math.Int(title.image.GetWidth() / 2), cy - 64, 10);
    logo.sprite.SetOpacity(0);
  }

bar_on = 1;
if (mode != "boot" && !halt)
  bar_on = 0;

fun show_bar(on)
  {
    track.sprite.SetOpacity(on);
    fill.sprite.SetOpacity(on);
  }
show_bar(bar_on);

fun set_fill(p)
  {
    w = Math.Int(176 * p);
    if (w < 3)
      w = 3;
    if (w != fill.width)
      {
        fill.width = w;
        fill.sprite.SetImage(fill.image.Scale(w, 4));
      }
  }

# Démarrage : la barre avance avec le temps, de plus en plus lentement, sans dépasser 60 %
fun boot_progress(duration, progress)
  {
    if (!halt)
      set_fill(0.6 * duration / (duration + 6));
  }
Plymouth.SetBootProgressFunction(boot_progress);

# Extinction : de 40 % vers la fin, de plus en plus lentement (l'écran est redessiné 50 fois par seconde)
frames = 0;
fun halt_refresh()
  {
    if (halt)
      {
        frames++;
        t = frames / 50;
        set_fill(0.4 + 0.58 * t / (t + 5));
      }
  }
Plymouth.SetRefreshFunction(halt_refresh);
if (halt)
  set_fill(0.4);

# Mot de passe (disque chiffré) : un champ à la place de la barre, un point par caractère
pw.entry = Sprite(Image("entry.png"));
pw.entry.SetPosition(cx - 120, cy + 44, 20);
pw.entry.SetOpacity(0);
pw.lock = Sprite(Image("lock.png"));
pw.lock.SetPosition(cx - 120 + 14, cy + 44 + 10, 21);
pw.lock.SetOpacity(0);
pw.dot = Image("bullet.png");

fun show_password(prompt, bullets)
  {
    show_bar(0);
    pw.entry.SetOpacity(1);
    pw.lock.SetOpacity(1);
    for (i = 0; pw.dots[i] || i < bullets; i++)
      {
        if (!pw.dots[i])
          {
            pw.dots[i].sprite = Sprite(pw.dot);
            pw.dots[i].sprite.SetPosition(cx - 120 + 40 + i * 14, cy + 44 + 14, 21);
          }
        if (i < bullets && i < 13)
          pw.dots[i].sprite.SetOpacity(1);
        else
          pw.dots[i].sprite.SetOpacity(0);
      }
  }
Plymouth.SetDisplayPasswordFunction(show_password);

fun show_normal()
  {
    pw.entry.SetOpacity(0);
    pw.lock.SetOpacity(0);
    for (i = 0; pw.dots[i]; i++)
      pw.dots[i].sprite.SetOpacity(0);
    show_bar(bar_on);
  }
Plymouth.SetDisplayNormalFunction(show_normal);
